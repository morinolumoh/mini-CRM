{
  "name": "Mini-CRM",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "python -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements.txt && sudo apt-get update -qq && sudo apt-get install -y -qq sqlite3",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Mini-CRM API" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "qwtel.sqlite-viewer"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.venv/bin/python"
      }
    }
  }
}
